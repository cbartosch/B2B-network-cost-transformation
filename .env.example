APP_ENV=development
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://workbench:workbench@localhost:5432/workbench
ALLOW_MOCK_AGENT_RUNS=true

# Optional package-index settings for corporate environments.
# Use a URL without embedded credentials. Supply credentials through an approved
# secret mechanism rather than committing them to .env or Docker image history.
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=60
