# ---------------------------------------------------------------------------
# Copy to .env before `docker compose up`.
#
# LIVE agent runs require a real provider key. With no key configured the
# system FAILS the run - it does not fall back to canned output. That is the
# spec 7.2B fail-closed rule and it is deliberate.
# ---------------------------------------------------------------------------

POSTGRES_PASSWORD=workbench_dev_only

# DEV | TEST | STAGING | PRODUCTION
# Resolved server-side. In PRODUCTION, MOCK runs are rejected at creation (7.2C).
WORKBENCH_ENVIRONMENT=DEV

# At least one provider is required for LIVE runs. Two are required for the
# conformance suite the spec mandates before production use (7.2).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# When true, pre-flight makes a real minimal provider call to prove liveness.
# Costs a few tokens per check. Default false.
PREFLIGHT_PROBE_LIVE=false

# Bound the provider clock-skew tolerance used by the liveness proof.
MAX_CLOCK_SKEW_SECONDS=300

# Simulation guards.
MAX_ENSEMBLE_SIZE=100
MAX_SIM_SITES=50000

# Optional shared secret. When set, every endpoint except /v1/health requires an
# X-API-Token header, and the interactive docs are switched off (Swagger UI
# cannot attach the header, so leaving them on would publish the API surface
# unauthenticated). Compose passes this to BOTH services - they must match, and
# the home page refuses to load if they do not.
API_TOKEN=

# How long the Streamlit interface waits on a single API call, in seconds.
# The slow calls are LIVE agent runs - a provider call with a hosted web
# search, plus independent fetches of each source it cites. When these exceed
# the limit the interface reports "API unreachable: timed out", which reads
# like an outage while the request is still running server-side. Raise it if
# you see that on a call you know is legitimately slow.
UI_API_TIMEOUT_SECONDS=360

# How long to wait for a provider response, in seconds. Two values, because
# they bound different things: a plain completion answers in seconds, while a
# call carrying the hosted web-search tool runs its searches server-side
# before replying - a sweep of several fact classes is minutes. If you see
# "transport error: The read operation timed out" on a research or prefill
# call, this is the one to raise.
LLM_TIMEOUT_SECONDS=60
LLM_SEARCH_TIMEOUT_SECONDS=480

# Explicit egress proxy for provider calls. Ambient HTTP_PROXY/HTTPS_PROXY are
# ignored (trust_env is off); name the proxy here and it is recorded on every
# llm_run row so the route is auditable.
LLM_EGRESS_PROXY=

# Require the provider's transport-issued request identifier (Anthropic
# `request-id`, OpenAI `x-request-id`) on every LIVE call. Off by default: a
# provider or intermediary can legitimately omit the header, and a hard
# requirement would fail genuine calls. Absence is always recorded and makes the
# run unverifiable - it carries no identifier to quote back to the provider.
REQUIRE_PROVIDER_REQUEST_ID=false

# --- corporate networks ----------------------------------------------------
# On an inspected network (Zscaler, Netskope, Palo Alto and similar) TLS is
# terminated and re-signed, so nothing in the container will verify until the
# re-signing CA is trusted. Put the .crt in certs/ and rebuild - see
# certs/README.md. `make tls-doctor` says which step is failing.
#
# The bundle below is built into the image from certs/. Override only if you
# mount a different one.
LLM_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# If outbound HTTPS must traverse a proxy. Ambient HTTP_PROXY/HTTPS_PROXY are
# deliberately ignored for provider calls; name it here and it is recorded on
# every call.
LLM_EGRESS_PROXY=

# Last resort. Turns certificate verification OFF for every provider call,
# which makes them readable and alterable by anything on the path. Supply the
# corporate CA instead. Refused in combination with TLS_PIN_MODE=ENFORCE.
LLM_INSECURE_SKIP_TLS_VERIFY=false

# --- TLS pinning -----------------------------------------------------------
# The liveness proof compares the provider's clock to ours, but an interceptor
# returns Date: <now> and passes. Pinning is what makes the two controls
# independent: a pinned connection fails even when the trust store has been
# subverted.
#
#   OFF      pins neither recorded nor checked
#   OBSERVE  pin recorded on every call, never enforced   (default)
#   ENFORCE  a call whose pin is unknown or unmatched FAILS
#
# You cannot pin what you have not seen. Run in OBSERVE, read the value from
# `make pins`, verify it against the provider's published certificate, set
# TLS_PINS, then switch to ENFORCE.
#
# Configure the sha256/ form. Two pins are computed per connection:
#
#   sha256/BASE64        the public key   - survives a certificate renewal
#   cert-sha256/BASE64   the certificate  - breaks on every renewal
#
# Either matching is accepted, so migrating between them is safe, but pinning a
# certificate hash buys an outage on the provider's next renewal. `make pins`
# suggests the SPKI form and reports the current certificate's expiry, which is
# the deadline for updating a pin.
TLS_PIN_MODE=OBSERVE
TLS_PINS=

# ENFORCE requires the cryptography package, because without it only certificate
# hashes can be computed - those break on every renewal, and with no certificate
# parsing there is no expiry to warn on, so the first sign is every call
# failing. The service refuses to start in that combination. Set this to true
# only if you mean to accept it.
TLS_PIN_ALLOW_CERT_ONLY=false

# ENFORCE requires the cryptography package, because without it only certificate
# hashes can be computed - and those break on every renewal, with no expiry
# warning because the expiry cannot be read either. That combination refuses to
# start rather than degrading quietly. Set this only if you have accepted the
# renewal exposure deliberately.
TLS_ALLOW_CERT_ONLY_PINNING=false

# Warn this many days before the pinned certificate expires.
TLS_PIN_EXPIRY_WARN_DAYS=21

# --- simulation job runner -------------------------------------------------
# Simulation is asynchronous: the endpoint returns 202 and a bounded worker pool
# does the work. A cancelled or failed run keeps its per-pass checkpoint and
# resumes to a byte-identical result.
# Two bounds measuring two different things. Conflating them meant interrupted
# runs could not be reclaimed whenever there was a backlog.
#
#   SIM_WORKERS    concurrent worker threads in one API process. Exceeding it
#                  leaves a run QUEUED for the next free worker, not refused.
#   SIM_QUEUE_MAX  total work accepted as NEW. Exceeding it refuses with 429,
#                  because accepting work nobody can get to is not a queue.
#
# Recovery of interrupted runs is exempt from SIM_QUEUE_MAX: it is finishing
# work already accepted, not admitting more.
SIM_WORKERS=2
SIM_QUEUE_MAX=32
SIM_CHECKPOINT_EVERY=5

# How long the deep half of /v1/health is cached. The container healthcheck
# polls the shallow half, which touches no database.
HEALTH_DEEP_TTL_SECONDS=30
